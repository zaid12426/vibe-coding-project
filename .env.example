# Copy this file to ".env" and fill in your values. Never commit .env to GitHub!

# MongoDB connection string (local MongoDB or a free MongoDB Atlas cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/ai-chat-assistant

# Which AI to use: "anthropic" (Claude) or "openai"
AI_PROVIDER=anthropic

# Fill in the key for the provider you chose
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the default models
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-4o-mini

PORT=3000
